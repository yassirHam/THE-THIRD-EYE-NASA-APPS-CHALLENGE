# ==============================================================================
# THE THIRD EYE — Environment Configuration (.env.example)
# NASA Space Apps Challenge 2026: Harmonization of MODIS and VIIRS Hot Spots
# Copy to .env for local overrides. NEVER commit .env to version control!
# ==============================================================================

# --- Runtime Environment ---
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Google Earth Engine & NASA Earthdata ---
GEE_PROJECT_ID=the-third-eye-2026
GEE_SERVICE_ACCOUNT=
GEE_PRIVATE_KEY_PATH=
EARTHDATA_USERNAME=
EARTHDATA_BEARER_TOKEN=

# --- FIRMS API (P0-Late In-App Hotspot View, strictly isolated from grid science) ---
FIRMS_MAP_KEY=

# --- Storage & Isolation Paths ---
# Sealed 2020-2021 holdout data lives outside Git and is accessible ONLY to P5
SEALED_EVAL_DIR=<ABSOLUTE_PATH_OUTSIDE_ANY_CLONE>/the-third-eye-eval-sealed
DEV_PARQUET_DIR=./data/parquet
ARTIFACT_OUTPUT_DIR=./public/artifacts

# --- Frontend & Ports ---
PORT_P3_A=5173
PORT_P3_B=5174
PORT_P3_C=5175
